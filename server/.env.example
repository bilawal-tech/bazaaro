# Copy this file to .env and fill in the values
PORT=5000
MONGO_URI=mongodb://localhost:27017/bazaaro

# Required. Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Rate limiting: max requests per IP per 15 minutes on /api (default 600).
# Set RATE_LIMIT_DISABLED=true while running the traffic simulator / load tests.
RATE_LIMIT_MAX=600
RATE_LIMIT_DISABLED=false

# Stripe (test mode). Keys: Dashboard -> Developers -> API keys. Kabhi git mein commit na karo.
STRIPE_SECRET_KEY=sk_test_xxx
# Local webhook secret: `stripe listen --forward-to localhost:5000/api/payments/webhook` jo whsec_... dega
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Default pkr. Agar Stripe PKR reject kare to usd rakho aur PKR_PER_USD set karo.
PAYMENT_CURRENCY=pkr
PKR_PER_USD=280
# Be-adaa card order itne minute baad auto-cancel (default 30)
UNPAID_ORDER_MINUTES=30

# Google login: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Wahi ID client/.env mein VITE_GOOGLE_CLIENT_ID mein bhi lagani hai.
GOOGLE_CLIENT_ID=

# Forgot password email (SMTP). Khali chhodo to local par link server console mein print hota hai.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=aap@gmail.com, SMTP_PASS=<16 char App Password>
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<re_ API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bazaaro <no-reply@example.com>

# Kafka events (data engineering pipeline). Pehle: docker compose --profile streaming up -d
# true karne par backend cart/order/payment/stock events Kafka mein bhejta hai. false = kuch nahi hota.
EVENTS_ENABLED=false
# Backend laptop par chal raha ho to localhost:29092; Docker ke andar server ho to compose khud kafka:9092 de deta hai
KAFKA_BROKERS=localhost:29092
