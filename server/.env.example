# Copy this file to .env and fill in the values
PORT=5000
MONGO_URI=mongodb://localhost:27017/bazaaro

# Required. Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Rate limiting: max requests per IP per 15 minutes on /api (default 600).
# Set RATE_LIMIT_DISABLED=true while running the traffic simulator / load tests.
RATE_LIMIT_MAX=600
RATE_LIMIT_DISABLED=false

# Stripe (test mode). Keys: Dashboard -> Developers -> API keys. Kabhi git mein commit na karo.
STRIPE_SECRET_KEY=sk_test_xxx
# Local webhook secret: `stripe listen --forward-to localhost:5000/api/payments/webhook` jo whsec_... dega
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Default pkr. Agar Stripe PKR reject kare to usd rakho aur PKR_PER_USD set karo.
PAYMENT_CURRENCY=pkr
PKR_PER_USD=280
# Be-adaa card order itne minute baad auto-cancel (default 30)
UNPAID_ORDER_MINUTES=30
