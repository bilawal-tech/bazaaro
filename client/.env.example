# Client (Vite) environment variables. Copy this file to .env and fill in what you need.
# Jo value khali ho wo website par dikhai nahi deti.

# Footer: contact details
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=

# Footer: social links (poora URL, e.g. https://instagram.com/yourstore)
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_X_URL=

# Backend ka URL (deploy ke waqt badlein)
VITE_BACKEND_URL=http://localhost:5000

# Stripe publishable key (test): Dashboard -> Developers -> API keys -> pk_test_...
# Secret key yahan kabhi nahi; woh sirf server/.env mein.
VITE_STRIPE_PUBLISHABLE_KEY=
